android_app {
    name: "CatShare",

    srcs: [
        "app/src/main/aidl/**/*.aidl",
        "app/src/main/java/**/*.kt",
        "app/src/platform/java/**/*.java",
    ],
    resource_dirs: ["app/src/main/res"],
    manifest: "app/src/platform/AndroidManifest.xml",

    platform_apis: true,
    system_ext_specific: true,
    certificate: "platform",
    privileged: true,
    required: ["privapp_whitelist_moe.reimu.catshare"],

    static_libs: [
        "androidx.activity_activity",
        "androidx.activity_activity-compose",
        "androidx.appcompat_appcompat",
        "androidx.compose.foundation_foundation",
        "androidx.compose.foundation_foundation-layout",
        "androidx.compose.material3_material3",
        "androidx.compose.material_material-icons-extended",
        "androidx.compose.runtime_runtime",
        "androidx.compose.runtime_runtime-saveable",
        "androidx.compose.ui_ui",
        "androidx.compose.ui_ui-graphics",
        "androidx.compose.ui_ui-tooling-preview",
        "androidx.core_core-ktx",
        "androidx.lifecycle_lifecycle-runtime-ktx",
        "com.google.android.material_material",
        "catshare_external_aars",
        "kotlin-reflect",
        "kotlin-parcelize-runtime",
        "kotlin-stdlib",
        "kotlinx-coroutines-android",
        "kotlinx_coroutines",
        "kotlinx_serialization_core",
        "kotlinx_serialization_json",
    ],

    defaults: ["catshare_external_jar_defaults"],

    kotlin_plugins: [
        "kotlin-parcelize-compiler-plugin",
        "kotlin-serialize-compiler-plugin",
    ],
    kotlincflags: ["-Xjvm-default=all"],

    optimize: {
        optimize: true,
        proguard_flags_files: ["app/proguard-rules.pro"],
        shrink_resources: true,
    },
}

prebuilt_etc {
    name: "privapp_whitelist_moe.reimu.catshare",
    system_ext_specific: true,
    sub_dir: "permissions",
    src: "privapp_whitelist_moe.reimu.catshare.xml",
    filename_from_src: true,
}
